# The deployed API the installed app talks to. Committed on purpose: a release
# build has to know its backend at build time, and a missing value now fails the
# build loudly rather than shipping an app pointed at localhost.
#
# Must be https:// with a certificate matching the host — iOS App Transport
# Security rejects cleartext, and the certificate on the server is issued to a
# domain, not to the IP.
VITE_API_HOST=https://platch-api.machekhin.com
