generator client {
  provider = "prisma-client-js"
  output   = "../../../prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String @id @default(uuid())
  username       String @unique
  hashedPassword String

  defaultEvenLengthMinutes Int

  projectsVersion Int @default(0)

  projects        Project[]
  timezoneChanges TimezoneChange[]
}

model Project {
  id      String  @id @default(uuid())
  name    String?
  goal    String?
  context String?

  timeNeededMinutes Int?
  minBlockMinutes   Int?
  repetitionsNeeded Int?

  earliestDate DateTime? @db.Date
  earliestTime DateTime? @db.Time(0)
  deadlineDate DateTime? @db.Date
  deadlineTime DateTime? @db.Time(0)

  projectStatus ProjectStatus
  projectType   ProjectType

  originalTimezone String

  user            User     @relation(fields: [userId], references: [id])
  userId          String
  parentProject   Project? @relation("ParentChildProjects", fields: [parentProjectId], references: [id])
  parentProjectId String?
  color           Color?   @relation(fields: [colorId], references: [id])
  colorId         String?

  position String

  childProjects           Project[]                @relation("ParentChildProjects")
  recurringTimeComponents RecurringTimeComponent[]
  events                  Event[]

  @@index([userId, projectStatus, parentProjectId, position])
}

model RecurringTimeComponent {
  id String @id @default(uuid())

  recurringInterval   Int
  recurringFrequency  RecurringFrequency
  recurringByDay      WEEKDAY[]
  recurringByMonthDay Int?
  recurringByMonth    Int?

  firstRecurringEventAt DateTime  @db.Timestamp(0)
  lastRecurringEventAt  DateTime? @db.Timestamp(0)

  project            Project              @relation(fields: [projectId], references: [id])
  projectId          String
  recurringTimeSlots RecurringTimeSlots[]

  events Event[]
}

model RecurringTimeSlots {
  id                    String                 @id @default(uuid())
  type                  RecurringTimeSlotsType
  from                  DateTime?              @db.Time(0)
  to                    DateTime?              @db.Time(0)
  flexibleMinutesNeeded Int?

  recurringTimeComponent   RecurringTimeComponent @relation(fields: [recurringTimeComponentId], references: [id])
  recurringTimeComponentId String
  events                   Event[]
}

model Event {
  id               String  @id @default(uuid())
  overridedName    String?
  overridedGoal    String?
  overridedContext String?

  start                    DateTime? @db.Timestamp(0)
  end                      DateTime? @db.Timestamp(0)
  recurringOccurrenceIndex Int?

  project                  Project                 @relation(fields: [projectId], references: [id])
  projectId                String
  recurringTimeComponent   RecurringTimeComponent? @relation(fields: [recurringTimeComponentId], references: [id])
  recurringTimeComponentId String?
  recurringTimeSlot        RecurringTimeSlots?     @relation(fields: [recurringTimeSlotsId], references: [id])
  recurringTimeSlotsId     String?

  @@unique([recurringTimeSlotsId, recurringOccurrenceIndex])
}

model TimezoneChange {
  id           String   @id @default(uuid())
  ianaTimezone String
  changesAt    DateTime @db.Timestamp(0)
  cityLabel    String?
  countryLabel String?
  deviceId     String?

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Color {
  id        String    @id @default(uuid())
  placement Int       @unique
  hexCode   String
  projects  Project[]
}

enum ProjectStatus {
  ACTIVE
  BACKLOG
}

enum ProjectType {
  EXTERNAL
  INTERNAL
}

enum RecurringTimeSlotsType {
  ABSOLUTE
  FLEXIBLE
}

enum RecurringFrequency {
  DAY
  WEEK
  MONTH
  YEAR
}

enum WEEKDAY {
  MO
  TU
  WE
  TH
  FR
  SA
  SU
}
