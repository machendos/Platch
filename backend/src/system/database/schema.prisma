generator client {
  provider = "prisma-client-js"
  output   = "../../../prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String @id @default(uuid())
  username       String @unique
  hashedPassword String
}

model Project {
  id      String @id @default(uuid())
  name    String
  goal    String
  context String

  timeNeededMinutes Int?
  minBlockMinutes   Int?
  repetitionsNeeded Int?

  parentProject   Project?  @relation(fields: [parentProjectId], references: [id])
  parentProjectId String?
  childProjects   Project[]
}

model TimeComponent {
  type TimeComponentType
}

enum TimeComponentType {
  EXACT_TIME
  RECURRING
}
